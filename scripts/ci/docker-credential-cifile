#!/usr/bin/env bash
set -euo pipefail

FILE="${DOCKER_CONFIG:?DOCKER_CONFIG non défini}/ci-credentials.json"
[[ -f "$FILE" ]] || { echo '{}' > "$FILE"; chmod 600 "$FILE"; }

save() { local tmp; tmp="$(mktemp "$FILE.XXXX")"; cat > "$tmp"; mv "$tmp" "$FILE"; }

case "${1:-}" in
  store)
    creds="$(cat)"
    url="$(jq -r .ServerURL <<<"$creds")"
    jq --arg u "$url" --argjson c "$creds" '.[$u] = $c' "$FILE" | save
    ;;
  get)
    url="$(cat)"
    jq -e --arg u "$url" '.[$u] // empty' "$FILE" 2>/dev/null \
      || { echo "credentials not found in native keychain"; exit 1; }
    ;;
  erase)
    url="$(cat)"
    jq --arg u "$url" 'del(.[$u])' "$FILE" | save
    ;;
  list)
    jq 'with_entries(.value = .value.Username)' "$FILE"
    ;;
  *)
    echo "usage: $0 store|get|erase|list" >&2
    exit 1
    ;;
esac
