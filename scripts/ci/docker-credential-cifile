#!/usr/bin/env bash
# Helper d'identifiants Docker minimal, utilisé UNIQUEMENT par la CI (voir deploy.sh).
# Stocke les identifiants dans $DOCKER_CONFIG/ci-credentials.json au lieu du trousseau macOS,
# inaccessible au runner qui tourne en service. Ce dossier est temporaire et supprimé après le job.
#
# Protocole docker-credential-helpers : docker appelle "<helper> store|get|erase|list"
# et échange du JSON {"ServerURL", "Username", "Secret"} sur stdin/stdout.
set -euo pipefail

FILE="${DOCKER_CONFIG:?DOCKER_CONFIG non défini}/ci-credentials.json"
[[ -f "$FILE" ]] || { echo '{}' > "$FILE"; chmod 600 "$FILE"; }

save() { local tmp; tmp="$(mktemp "$FILE.XXXX")"; cat > "$tmp"; mv "$tmp" "$FILE"; }

case "${1:-}" in
  store)
    creds="$(cat)"
    url="$(jq -r .ServerURL <<<"$creds")"
    jq --arg u "$url" --argjson c "$creds" '.[$u] = $c' "$FILE" | save
    ;;
  get)
    url="$(cat)"
    # Message exact attendu par docker quand il n'y a pas d'identifiants (→ accès anonyme)
    jq -e --arg u "$url" '.[$u] // empty' "$FILE" 2>/dev/null \
      || { echo "credentials not found in native keychain"; exit 1; }
    ;;
  erase)
    url="$(cat)"
    jq --arg u "$url" 'del(.[$u])' "$FILE" | save
    ;;
  list)
    jq 'with_entries(.value = .value.Username)' "$FILE"
    ;;
  *)
    echo "usage: $0 store|get|erase|list" >&2
    exit 1
    ;;
esac
